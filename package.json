{
  "name": "gtfs-to-chart",
  "version": "2.2.0",
  "private": false,
  "description": "Generate stringline charts of a transit routes from GTFS",
  "keywords": [
    "transit",
    "gtfs",
    "transportation",
    "visualizations",
    "stringline",
    "d3"
  ],
  "bugs": {
    "url": "https://github.com/blinktaginc/gtfs-to-chart/issues"
  },
  "repository": {
    "url": "https://github.com/BlinkTagInc/gtfs-to-chart.git"
  },
  "license": "MIT",
  "author": "Brendan Nee <brendan@blinktag.com>",
  "type": "module",
  "main": "index.js",
  "bin": {
    "gtfs-to-chart": "bin/gtfs-to-chart.js"
  },
  "scripts": {
    "start": "node app/index.js",
    "prepare": "husky",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "better-copy": "^1.0.4",
    "chalk": "^6.0.1",
    "connect-slashes": "^1.4.0",
    "express": "^5.3.0",
    "gtfs": "5.0.0-beta.0",
    "js-beautify": "^2.0.3",
    "lodash-es": "^4.18.1",
    "moment": "^2.31.0",
    "progress": "^2.0.3",
    "pug": "^3.0.4",
    "sanitize-filename": "^1.6.4",
    "simplify-geojson": "^1.0.5",
    "timer-machine": "^1.1.0",
    "untildify": "^6.0.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.json": "prettier --write",
    "*.{js,css,md}": "prettier --write"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
